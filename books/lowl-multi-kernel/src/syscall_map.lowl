//
// Syscall translation map in lowl: abstract LOWL operation -> native number,
// per kernel, plus emulation flags and collision detection.
//
// The compiler cannot index arrays, so the map is a chain of comparisons.
// Every function here is scalar in and scalar out: string literals only work
// inside main in lowl v2.1.0, so all printing happens there.

fn op_count() -> u64:
    return 12

fn kernel_count() -> u64:
    return 4

// Sentinel for "this kernel has no entry for the operation".
fn absent() -> u64:
    return 0xFFFFFFFF

fn is_none(n: u64) -> u64:
    if n == 0xFFFFFFFF:
        return 1
    return 0

// Abstract operations, in table order:
// 0 read, 1 write, 2 open, 3 close, 4 stat, 5 mmap, 6 thread_create,
// 7 fork, 8 signal_deliver, 9 sem_acquire, 10 async_io, 11 tcp_connect
fn linux_nr(op: u64) -> u64:
    if op == 0:
        return 0
    if op == 1:
        return 1
    if op == 2:
        return 2
    if op == 3:
        return 3
    if op == 4:
        return 4
    if op == 5:
        return 9
    if op == 6:
        return 56
    if op == 7:
        return 57
    if op == 8:
        return 62
    if op == 9:
        return 202
    if op == 10:
        return 425
    if op == 11:
        return 42
    return absent()

fn bsd_nr(op: u64) -> u64:
    if op == 0:
        return 3
    if op == 1:
        return 4
    if op == 2:
        return 5
    if op == 3:
        return 6
    if op == 4:
        return 188
    if op == 5:
        return 197
    if op == 6:
        return 455
    if op == 7:
        return 2
    if op == 8:
        return 103
    if op == 9:
        return 468
    if op == 10:
        return 363
    if op == 11:
        return 98
    return absent()

fn nt_nr(op: u64) -> u64:
    if op == 0:
        return 6
    if op == 1:
        return 8
    if op == 2:
        return 85
    if op == 3:
        return 15
    if op == 4:
        return 17
    if op == 5:
        return 24
    if op == 6:
        return 194
    if op == 7:
        return 165
    if op == 8:
        return 69
    if op == 9:
        return 4
    if op == 10:
        return 7
    if op == 11:
        return 7
    return absent()

fn os2_nr(op: u64) -> u64:
    if op == 0:
        return 0x72
    if op == 1:
        return 0x73
    if op == 2:
        return 0x76
    if op == 3:
        return 0x77
    if op == 4:
        return 0x4E
    if op == 5:
        return 0x51
    if op == 6:
        return 0x0A
    if op == 7:
        return 0x5B
    if op == 8:
        return 0x38
    if op == 9:
        return 0x2A
    return absent()

// kernel 0 linux, 1 freebsd, 2 windows nt, 3 os2
fn number(op: u64, kernel: u64) -> u64:
    if kernel == 0:
        return linux_nr(op)
    if kernel == 1:
        return bsd_nr(op)
    if kernel == 2:
        return nt_nr(op)
    return os2_nr(op)

// 1 when the kernel reaches the operation through an emulation layer.
fn emulated(op: u64, kernel: u64) -> u64:
    if kernel == 1 and op == 10:
        return 1
    if kernel == 2 and op == 7:
        return 1
    if kernel == 2 and op == 8:
        return 1
    if kernel == 2 and op == 11:
        return 1
    if kernel == 3 and op == 7:
        return 1
    if kernel == 3 and op == 8:
        return 1
    return 0

fn supported(op: u64, kernel: u64) -> u64:
    if is_none(number(op, kernel)) == 1:
        return 0
    return 1

fn count(kernel: u64) -> u64:
    let mut op: u64 = 0
    let mut n: u64 = 0
    while op < op_count():
        if supported(op, kernel) == 1:
            n = n + 1
        op = op + 1
    return n

fn emulated_count(kernel: u64) -> u64:
    let mut op: u64 = 0
    let mut n: u64 = 0
    while op < op_count():
        if emulated(op, kernel) == 1:
            n = n + 1
        op = op + 1
    return n

// How many distinct operations share the number that `op` lands on.
fn aliases(op: u64, kernel: u64) -> u64:
    let target: u64 = number(op, kernel)
    if is_none(target) == 1:
        return 0
    let mut i: u64 = 0
    let mut n: u64 = 0
    while i < op_count():
        if number(i, kernel) == target:
            n = n + 1
        i = i + 1
    return n

fn collisions(kernel: u64) -> u64:
    let mut op: u64 = 0
    let mut n: u64 = 0
    while op < op_count():
        if aliases(op, kernel) > 1:
            n = n + 1
        op = op + 1
    return n

// Re-express a Linux number as the number the target kernel uses. 0 means the
// remap is impossible because one of the two sides has no entry.
fn remap_ok(op: u64, src: u64, dst: u64) -> u64:
    if supported(op, src) == 0:
        return 0
    if supported(op, dst) == 0:
        return 0
    return 1

fn name(op: u64) -> u64:
    return op

fn main() -> u32:
    print_string("syscall map, 12 abstract ops over 4 kernels\n\n")

    let mut k: u64 = 0
    while k < kernel_count():
        if k == 0:
            print_string("linux")
        elif k == 1:
            print_string("freebsd")
        elif k == 2:
            print_string("windows nt")
        else:
            print_string("os2")
        print_string(" mapped=")
        print_u64(count(k))
        print_string(" emulated=")
        print_u64(emulated_count(k))
        print_string(" native=")
        print_u64(count(k) - emulated_count(k))
        print_string(" collisions=")
        print_u64(collisions(k))
        print_string("\n")
        k = k + 1

    print_string("\nnumber per operation (linux freebsd nt os2)\n")
    let mut op: u64 = 0
    while op < op_count():
        print_string("  ")
        print_u64(name(op))
        print_string(" ")
        if op == 0:
            print_string("read          ")
        elif op == 1:
            print_string("write         ")
        elif op == 2:
            print_string("open          ")
        elif op == 3:
            print_string("close         ")
        elif op == 4:
            print_string("stat          ")
        elif op == 5:
            print_string("mmap          ")
        elif op == 6:
            print_string("thread_create ")
        elif op == 7:
            print_string("fork          ")
        elif op == 8:
            print_string("signal_deliver")
        elif op == 9:
            print_string("sem_acquire   ")
        elif op == 10:
            print_string("async_io      ")
        else:
            print_string("tcp_connect   ")
        let mut kk: u64 = 0
        while kk < kernel_count():
            let n: u64 = number(op, kk)
            print_string(" ")
            if is_none(n) == 1:
                print_string("-")
            else:
                print_u64(n)
            if emulated(op, kk) == 1:
                print_string("e")
            kk = kk + 1
        print_string("\n")
        op = op + 1

    print_string("\naliased numbers\n")
    print_string("  nt number 7 aliases ")
    print_u64(aliases(10, 2))
    print_string(" ops (async_io and tcp_connect)\n")
    print_string("  os2 number 0 aliases ")
    print_u64(aliases(0, 3))
    print_string(" ops\n")

    print_string("\nremap fork linux -> freebsd ")
    if remap_ok(7, 0, 1) == 1:
        print_string("ok number ")
        print_u64(number(7, 1))
    else:
        print_string("impossible")
    print_string("\n")
    print_string("remap async_io linux -> os2 ")
    if remap_ok(10, 0, 3) == 1:
        print_string("ok number ")
        print_u64(number(10, 3))
    else:
        print_string("impossible, os2 has no entry")
    print_string("\n")

    print_string("\nos2 ordinals in hex\n")
    print_string("  open ")
    print_hex_u64(number(2, 3))
    print_string("  read ")
    print_hex_u64(number(0, 3))
    print_string("  fork ")
    print_hex_u64(number(7, 3))
    print_string("\n")
    return 0
