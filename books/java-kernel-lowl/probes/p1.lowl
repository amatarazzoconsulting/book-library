fn in_i8(v: i64) -> u64:
    if v >= -128 and v <= 127:
        return 1
    return 0

fn main() -> u32:
    print_u64(in_i8(127))
    print_string(" ")
    print_u64(in_i8(128))
    print_string(" ")
    print_u64(in_i8(0 - 128))
    print_string(" ")
    print_u64(in_i8(0 - 129))
    print_string("\n")
    let neg: i64 = 0 - 7
    print_i64(neg)
    print_string(" ")
    print_u64(neg < 0)
    print_string("\n")
    return 0
